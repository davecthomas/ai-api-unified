########################################################################
#   CORE ENGINE SELECTION
########################################################################
# Which embedding model family?   openai | titan | google-gemini | voyage
# EMBEDDING_ENGINE=titan
# EMBEDDING_ENGINE=voyage
EMBEDDING_ENGINE=google-gemini


########################################################################
#   OPENAI / TITAN / Google API CREDENTIALS
########################################################################
# --- OpenAI ---
OPENAI_API_KEY=
# Optional API base-URL override; also points the openai engine at any
# OpenAI-compatible server. Same https rule as above.
OPENAI_BASE_URL_OVERRIDE=
# --- Anthropic (native Claude API; used by COMPLETIONS_ENGINE=claude) ---
ANTHROPIC_API_KEY=
# Optional Admin API key (sk-ant-admin...) for organization-level finops
# attribution: when set, cost events carry your org id AND name (resolved
# once per client from the Admin API). When unset, cost events carry the org
# id only, captured from one free count_tokens response header. Fails open:
# cost events omit org identity if resolution fails.
ANTHROPIC_ADMIN_KEY=
# Optional API base-URL override for gateways, proxies, or local test
# servers (LiteLLM, Helicone, Cloudflare AI Gateway, vLLM, Ollama). Must be
# https:// unless it targets localhost/127.0.0.1/::1. Deliberately named
# _OVERRIDE so it does not collide with the SDK's own ANTHROPIC_BASE_URL.
ANTHROPIC_BASE_URL_OVERRIDE=
# The Admin API key grants org-wide read/write, so it does NOT follow the
# override above. Set this only if the admin lookup should also route through
# a gateway (egress-restricted networks).
ANTHROPIC_ADMIN_BASE_URL_OVERRIDE=
# Geo-residency constraint (optional: US | USA | United States)
AI_API_GEO_RESIDENCY=
# --- Voyage AI (embeddings; used by EMBEDDING_ENGINE=voyage) ---
VOYAGE_API_KEY=
GOOGLE_GEMINI_API_KEY=
# Optional API base-URL override for Gemini. Same https rule as above.
GOOGLE_GEMINI_BASE_URL_OVERRIDE=
GOOGLE_AUTH_METHOD=api_key
# Completions engine (openai | openai-responses | claude | google-gemini | nova | anthropic | ...)
COMPLETIONS_ENGINE=google-gemini

# Generic AI settings
# Embedding model name (text-embedding-3-small | amazon.titan-embed-text-v2:0 | gemini-embedding-001 | voyage-3)
EMBEDDING_MODEL_NAME=gemini-embedding-001
# EMBEDDING_MODEL_NAME=amazon.titan-embed-text-v2:0
# Completions model name, by engine:
#   openai:        gpt-5.5 | gpt-5.4 | gpt-5.4-mini | gpt-5.4-nano | gpt-4o-mini
#   claude:        claude-opus-5 | claude-sonnet-5 | claude-fable-5 | claude-opus-4-8 | claude-haiku-4-5
#   google-gemini: gemini-3.6-flash | gemini-3.5-flash | gemini-3.5-flash-lite | gemini-3.1-pro-preview | gemini-2.5-flash
#   nova:          amazon.nova-micro-v1:0 | amazon.nova-lite-v1:0
COMPLETIONS_MODEL_NAME=gemini-3.5-flash
# COMPLETIONS_MODEL_NAME=gemini-3.6-flash
# COMPLETIONS_MODEL_NAME=claude-opus-5
# COMPLETIONS_MODEL_NAME=gpt-5.5
# COMPLETIONS_MODEL_NAME=amazon.nova-lite-v1:0
# Embedding dimensions (1536 for OpenAI | 1024 for Titan | 3072 default for Gemini)
# Leave unset to use the provider default for the selected engine.
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_DIMENSIONS=3072
# Vector metric (cosine for Pinecone | cosinesimil for OpenSearch | COSINE for Redis)
# VECTOR_METRIC=cosinesimil
VECTOR_METRIC=cosine

AWS_REGION=us-east-1

# AWS credentials for Bedrock - these are ephermeral and must be set at runtime. 
# Read more here: https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-envvars.html
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ----------------------------------------
# AI Voice Settings
# ----------------------------------------
# ElevenLabs API key
ELEVEN_LABS_API_KEY=

# Voice engine: "elevenlabs", "google", "openai", "azure"
AI_VOICE_ENGINE=google

# Language code (e.g. en, de)
AI_VOICE_LANGUAGE=en

########################################################################
#   Google AI Voice Settings
# OSS defaults to API-key auth for Google. Service-account / Vertex mode remains
# available by setting GOOGLE_AUTH_METHOD=service_account and providing the
# usual Google credentials below.
# GOOGLE_APPLICATION_CREDENTIALS=credentials/<filename>.json
# GOOGLE_PROJECT_ID=
# GOOGLE_LOCATION=us-central1
# Preferred Google TTS model
DEFAULT_GEMINI_TTS_MODEL=gemini-2.5-pro-tts

########################################################################
#   Google Gemini AI Settings (Completions & Embeddings)
# Uses GOOGLE_GEMINI_API_KEY by default.
# COMPLETIONS_ENGINE=google-gemini
# EMBEDDING_ENGINE=google-gemini
# Default models:
#   Completions: gemini-3.5-flash
#   Embeddings: gemini-embedding-001

########################################################################
# OpenAI AI Voice Settings
OPENAI_API_KEY=
# AI_VOICE_ENGINE=openai

########################################################################
# Azure AI Voice Settings
# AI_VOICE_ENGINE=azure
MICROSOFT_COGNITIVE_SERVICES_API_KEY=your-microsoft-cognitive-services-api-key
MICROSOFT_COGNITIVE_SERVICES_API_KEY_2=your-microsoft-cognitive-services-api-key-2
MICROSOFT_COGNITIVE_SERVICES_REGION=eastus
MICROSOFT_COGNITIVE_SERVICES_ENDPOINT=https://eastus.api.cognitive.microsoft.com/

# Image engine: openai | nova-canvas | google-gemini
IMAGE_ENGINE=google-gemini
# image model used for image generation requests: openai: gpt-image-1 ; amazon nova: amazon.nova-canvas-v1:0 ; google gemini: imagen-4.0-generate-001
IMAGE_MODEL_NAME=imagen-4.0-generate-001

# Video engine: openai | google-gemini | nova-reel | nova | bedrock
# The simplest OSS default path is Google Veo via API key auth.
VIDEO_ENGINE=google-gemini
# Video model defaults by provider when left unset:
#   openai -> sora-2
#   google-gemini -> veo-3.1-lite-generate-preview
#   nova-reel / bedrock -> amazon.nova-reel-v1:1
VIDEO_MODEL_NAME=veo-3.1-lite-generate-preview
# Local directory used when the library materializes generated videos.
VIDEO_OUTPUT_DIR=./generated_videos
# Optional blocking-flow tuning for video polling.
# VIDEO_POLL_INTERVAL_SECONDS=10
# VIDEO_TIMEOUT_SECONDS=900
# Required for Bedrock Nova Reel unless passed on the request itself.
# BEDROCK_VIDEO_OUTPUT_S3_URI=s3://your-bucket/ai-api-unified/video-output/
