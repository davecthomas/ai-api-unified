########################################################################
#   EVERYTHING BUT SECRETS LIVES IN models.json
########################################################################
# Engines, models, the fallback chain, thinking, the router, the
# classifier, the model check, provider base URLs and regions, the
# OpenAI-compatible server, the PII and observability middleware, and the
# allow/deny policy are authored in models.json: copy models_sample.json,
# which documents every section, and check it with
#   poetry run python -m ai_api_unified.config_schema validate models.json
# AI_MODELS_CONFIG names the file (a path to .json, .yaml, or .yml, or
# inline JSON). Unset means ./models.json when it exists; blank turns the
# file off.
# AI_MODELS_CONFIG=./models.json
#
# This file holds secrets only. A pre-models.json setting left in .env
# still overrides the file and logs a deprecation warning; move it with
#   poetry run python scripts/migrate2json.py --comment-env


########################################################################
#   OPENAI (also the openai-compatible engine's key)
########################################################################
OPENAI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=


########################################################################
#   ANTHROPIC (native Claude API; engine "claude")
########################################################################
ANTHROPIC_API_KEY=
# Optional Admin API key (sk-ant-admin...) for organization-level finops
# attribution: cost events then carry your org id and name. Fails open.
ANTHROPIC_ADMIN_KEY=


########################################################################
#   GOOGLE (Gemini completions, embeddings, images, videos, voice)
########################################################################
GOOGLE_GEMINI_API_KEY=
# Service-account / Vertex auth (providers.google.auth_method in models.json):
# GOOGLE_APPLICATION_CREDENTIALS=credentials/<filename>.json


########################################################################
#   VOYAGE AI (embeddings engine "voyage")
########################################################################
VOYAGE_API_KEY=


########################################################################
#   AWS (Bedrock, Titan, Nova)
########################################################################
# AWS credentials for Bedrock are ephemeral and must be set at runtime.
# Read more here: https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-envvars.html
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# The region may live here (AWS hosts set it themselves) or in models.json
# as providers.aws.region; the environment wins. Default us-east-1.
# AWS_REGION=us-east-1


########################################################################
#   VOICE PROVIDERS
########################################################################
ELEVEN_LABS_API_KEY=
# Azure speech; its region is providers.azure_speech.region in models.json.
MICROSOFT_COGNITIVE_SERVICES_API_KEY=
