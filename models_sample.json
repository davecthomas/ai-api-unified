{
  "allow": ["claude:*", "google-gemini:*", "openai:*", "openai-decisions:*"],
  "deny": ["openai:gpt-4*", "bedrock"],

  "completions": {
    "engine": "google-gemini",
    "model": "gemini-2.5-flash",
    "fallbacks": ["claude:claude-sonnet-5", "openai:gpt-5.6-luna"],
    "fallback_on": "unavailable,rate_limited,quota_exhausted,auth_rejected",
    "retry_policy": "default",
    "thinking": "medium",
    "cooldown": {
      "enabled": true,
      "seconds": {"rate_limited": 30, "unavailable": 30, "quota_exhausted": 300}
    }
  },

  "classifier": {
    "engine": "openai-decisions",
    "model": "gpt-6-luna",
    "timeout_seconds": 5,
    "min_confidence": 0.6
  },

  "router": {
    "tiers": [
      {"name": "easy",   "models": ["google-gemini:gemini-2.5-flash-lite", "claude:claude-haiku-4-5"], "thinking": "off"},
      {"name": "medium", "models": ["google-gemini:gemini-2.5-flash", "claude:claude-sonnet-5"]},
      {"name": "hard",   "description": "Multi-step reasoning, long synthesis, cross-file code, or anything where a wrong answer is costly.",
                         "models": ["claude:claude-opus-5-5", "google-gemini:gemini-2.5-pro"], "thinking": "high"}
    ],
    "default_tier": "medium",
    "on_exhausted": "escalate",
    "followup": "reclassify"
  },

  "model_check": {"mode": "prune", "timeout_seconds": 10},

  "embeddings": {"engine": "google-gemini", "model": "gemini-embedding-001", "dimensions": 0},
  "images":     {"engine": "google-gemini", "model": "gemini-3.1-flash-image"},
  "videos":     {"engine": "google-gemini", "model": "veo-3.1-lite-generate-preview", "output_dir": "./videos"},
  "voice":      {"engine": "google", "tts_model": "gemini-2.5-pro-tts", "language": "en-US"},

  "geo_residency": null
}
