{
  "$schema": "https://raw.githubusercontent.com/davecthomas/ai-api-unified/main/src/ai_api_unified/schemas/models.schema.json",
  "config_version": "2026-10-16",
  "service": "my-service",
  "allow": ["claude:*", "google-gemini:*", "openai:*", "openai-decisions:*"],
  "deny": ["openai:gpt-4*", "bedrock"],

  "completions": {
    "engine": "google-gemini",
    "model": "gemini-2.5-flash",
    "fallbacks": ["claude:claude-sonnet-5", "openai:gpt-5.6-luna"],
    "fallback_on": "unavailable,rate_limited,quota_exhausted,auth_rejected",
    "retry_policy": "default",
    "thinking": "medium",
    "cooldown": {
      "enabled": true,
      "seconds": {"rate_limited": 30, "unavailable": 30, "quota_exhausted": 300}
    },
    "require": {
      "capabilities": ["structured_output", "tool_use", "streaming"],
      "second_provider": true,
      "mode": "warn"
    }
  },

  "classifier": {
    "engine": "openai-decisions",
    "model": "gpt-6-luna",
    "timeout_seconds": 5,
    "min_confidence": 0.6
  },

  "router": {
    "tiers": [
      {"name": "easy",   "models": ["google-gemini:gemini-2.5-flash-lite", "claude:claude-haiku-4-5"], "thinking": "off"},
      {"name": "medium", "models": ["google-gemini:gemini-2.5-flash", "claude:claude-sonnet-5"]},
      {"name": "hard",   "description": "Multi-step reasoning, long synthesis, cross-file code, or anything where a wrong answer is costly.",
                         "models": ["claude:claude-opus-5-5", "google-gemini:gemini-2.5-pro"], "thinking": "high"}
    ],
    "default_tier": "medium",
    "on_exhausted": "escalate",
    "followup": "reclassify"
  },

  "model_check": {"mode": "prune", "timeout_seconds": 10},

  "embeddings": {"engine": "google-gemini", "model": "gemini-embedding-001", "dimensions": 0},
  "images":     {"engine": "google-gemini", "model": "gemini-3.1-flash-image"},
  "videos":     {"engine": "google-gemini", "model": "veo-3.1-lite-generate-preview", "output_dir": "./videos"},
  "voice":      {"engine": "google", "tts_model": "gemini-2.5-pro-tts", "language": "en-US"},

  "geo_residency": null,

  "providers": {
    "openai":            {"base_url": null, "user": null},
    "anthropic":         {"base_url": null, "admin_base_url": null, "user": null},
    "google":            {"auth_method": "api_key", "project_id": null, "location": "us-central1", "base_url": null},
    "aws":               {"region": "us-east-1"},
    "openai_compatible": {"base_url": null, "structured_output": "json_schema", "context_window": null},
    "azure_speech":      {"region": "eastus"}
  },

  "middleware": [
    {"name": "observability", "enabled": false,
     "settings": {"direction": "input_output", "capabilities": ["completions", "embeddings", "images", "tts"],
                  "log_level": "INFO", "token_count_mode": "provider_or_estimate"}},
    {"name": "pii_redaction", "enabled": false,
     "settings": {"direction": "input_only"}},
    {"name": "guardrails", "enabled": false,
     "settings": {"on_fail": "block", "on_error": "block",
                  "prompt_injection": {"threshold": 0.8},
                  "harmful_content": {"backend": "auto", "threshold": 0.8},
                  "custom": [{"name": "no_competitors", "terms": ["Acme Corp"], "action": "flag"}]}},
    {"name": "response_cache", "enabled": false,
     "settings": {"max_entries": 10000,
                  "operations": {"embeddings": {"ttl_seconds": 86400},
                                 "completions": {"ttl_seconds": 3600}}}}
  ],

  "strict_deprecations": false,

  "environments": {
    "prod": {
      "model_check": {"mode": "strict"},
      "completions": {"require": {"mode": "strict"}}
    },
    "dev": {
      "completions": {"model": "gemini-2.5-flash-lite", "fallbacks": []}
    }
  }
}
