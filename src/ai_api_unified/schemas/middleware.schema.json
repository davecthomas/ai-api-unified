{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davecthomas/ai-api-unified/main/src/ai_api_unified/schemas/middleware.schema.json",
  "title": "ai_api_unified middleware configuration",
  "type": "object",
  "properties": {
    "middleware": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "guardrails",
              "observability",
              "pii_redaction",
              "response_cache"
            ]
          },
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "settings": {
            "description": "Settings for the named middleware."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "const": "guardrails"
                }
              }
            },
            "then": {
              "properties": {
                "settings": {
                  "$ref": "#/$defs/GuardrailsSettingsModel"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "observability"
                }
              }
            },
            "then": {
              "properties": {
                "settings": {
                  "$ref": "#/$defs/ObservabilitySettingsModel"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "pii_redaction"
                }
              }
            },
            "then": {
              "properties": {
                "settings": {
                  "$ref": "#/$defs/PiiRedactionSettingsModel"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "response_cache"
                }
              }
            },
            "then": {
              "properties": {
                "settings": {
                  "$ref": "#/$defs/ResponseCacheSettingsModel"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "RedactionRecognizerRuleSettingsModel": {
      "additionalProperties": true,
      "description": "Typed model for one configurable custom recognizer rule block.\n\nThis model intentionally exposes middleware-level semantics only.\nIt does not expose implementation-provider identifiers in the YAML contract.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "confidence_threshold": {
          "default": 0.0,
          "title": "Confidence Threshold"
        },
        "context_terms": {
          "title": "Context Terms"
        },
        "negative_context_terms": {
          "title": "Negative Context Terms"
        }
      },
      "title": "RedactionRecognizerRuleSettingsModel",
      "type": "object"
    },
    "RedactionRecognizersSettingsModel": {
      "additionalProperties": true,
      "description": "Typed model for `redaction_recognizers` middleware extension settings.",
      "properties": {
        "proximity_window_chars": {
          "default": 28,
          "title": "Proximity Window Chars"
        },
        "ssn_last4": {},
        "cc_last4": {},
        "dob": {}
      },
      "title": "RedactionRecognizersSettingsModel",
      "type": "object"
    },
    "PiiRedactionSettingsModel": {
      "additionalProperties": true,
      "description": "Typed model for the `pii_redaction.settings` block.\nDefaults are intentionally lenient to keep configuration migration smooth.",
      "properties": {
        "direction": {
          "default": "input_only",
          "title": "Direction"
        },
        "strict_mode": {
          "default": false,
          "title": "Strict Mode",
          "type": "boolean"
        },
        "detection_profile": {
          "default": "balanced",
          "title": "Detection Profile"
        },
        "language": {
          "default": "en",
          "title": "Language"
        },
        "country_scope": {
          "default": "US",
          "title": "Country Scope"
        },
        "address_detection_enabled": {
          "default": true,
          "title": "Address Detection Enabled",
          "type": "boolean"
        },
        "address_detection_provider": {
          "default": "usaddress",
          "title": "Address Detection Provider"
        },
        "span_conflict_policy": {
          "default": "prefer_usaddress_longest",
          "title": "Span Conflict Policy"
        },
        "default_redaction_label": {
          "default": "REDACTED",
          "title": "Default Redaction Label",
          "type": "string"
        },
        "allowed_entities": {
          "title": "Allowed Entities"
        },
        "entity_label_map": {
          "title": "Entity Label Map"
        },
        "redaction_recognizers": {}
      },
      "title": "PiiRedactionSettingsModel",
      "type": "object"
    },
    "ObservabilitySettingsModel": {
      "additionalProperties": true,
      "description": "Typed model for logger-backed observability middleware settings.",
      "properties": {
        "direction": {
          "default": "input_output",
          "title": "Direction"
        },
        "capabilities": {
          "title": "Capabilities"
        },
        "log_level": {
          "default": "INFO",
          "title": "Log Level"
        },
        "token_count_mode": {
          "default": "provider_or_estimate",
          "title": "Token Count Mode"
        },
        "include_media_details": {
          "default": true,
          "title": "Include Media Details",
          "type": "boolean"
        },
        "include_provider_usage": {
          "default": true,
          "title": "Include Provider Usage",
          "type": "boolean"
        },
        "include_audio_byte_count": {
          "default": true,
          "title": "Include Audio Byte Count",
          "type": "boolean"
        },
        "include_image_byte_count": {
          "default": true,
          "title": "Include Image Byte Count",
          "type": "boolean"
        },
        "include_video_byte_count": {
          "default": true,
          "title": "Include Video Byte Count",
          "type": "boolean"
        },
        "emit_error_events": {
          "default": true,
          "title": "Emit Error Events",
          "type": "boolean"
        },
        "emit_cost": {
          "default": false,
          "title": "Emit Cost",
          "type": "boolean"
        },
        "emit_cost_topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emit Cost Topic"
        }
      },
      "title": "ObservabilitySettingsModel",
      "type": "object"
    },
    "ResponseCacheOperationSettingsModel": {
      "additionalProperties": false,
      "description": "One operation's cache settings.\n\nAttributes:\n    enabled: False turns the cache off for this operation.\n    ttl_seconds: How long a stored answer stays valid; None uses the\n        operation's default.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "ttl_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttl Seconds"
        }
      },
      "title": "ResponseCacheOperationSettingsModel",
      "type": "object"
    },
    "ResponseCacheSettingsModel": {
      "additionalProperties": false,
      "description": "The `response_cache` middleware: stored answers for identical requests.\n\nAttributes:\n    max_entries: Entries the default in-memory store keeps before it\n        evicts the least recently used. A store the application supplies\n        manages its own size.\n    ttl_seconds: Default validity for every operation, overriding the\n        per-operation defaults; None keeps them.\n    operations: Per-operation overrides, keyed by completions,\n        structured_output, conversation, embeddings, or classification.\n        An operation absent here is on with its default TTL.",
      "properties": {
        "max_entries": {
          "default": 10000,
          "minimum": 1,
          "title": "Max Entries",
          "type": "integer"
        },
        "ttl_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttl Seconds"
        },
        "operations": {
          "title": "Operations"
        }
      },
      "title": "ResponseCacheSettingsModel",
      "type": "object"
    },
    "GuardrailClassifierSettingsModel": {
      "additionalProperties": false,
      "description": "The classifier the model-backed checks use; None fields follow models.json.",
      "properties": {
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "title": "GuardrailClassifierSettingsModel",
      "type": "object"
    },
    "GuardrailCustomCheckSettingsModel": {
      "additionalProperties": false,
      "description": "A custom policy: local rules (no provider call), or a yes/no question\nthe classifier answers.\n\nAttributes:\n    name: The check's name, as records report it. Letters, digits,\n        underscores.\n    patterns: Regular expressions; any match fires the check.\n    terms: Case-insensitive substrings; any match fires the check.\n    question: A yes/no condition for the classifier, for policies rules\n        cannot express (\"Does this text give medical advice?\").\n    threshold: For `question`: probability at or above which it fires.\n    action: `block` or `flag`; None inherits the file-wide `on_fail`.\n    direction: Which side the check reads; default both.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "patterns": {
          "items": {
            "type": "string"
          },
          "title": "Patterns",
          "type": "array"
        },
        "terms": {
          "items": {
            "type": "string"
          },
          "title": "Terms",
          "type": "array"
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "threshold": {
          "default": 0.8,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        },
        "action": {
          "default": null,
          "title": "Action"
        },
        "direction": {
          "default": "input_output",
          "title": "Direction"
        }
      },
      "required": [
        "name"
      ],
      "title": "GuardrailCustomCheckSettingsModel",
      "type": "object"
    },
    "GuardrailModelCheckSettingsModel": {
      "additionalProperties": false,
      "description": "A model-backed check: prompt_injection or harmful_content.\n\nAttributes:\n    enabled: False turns the check off.\n    backend: `auto` (OpenAI Moderation when OPENAI_API_KEY is set, else\n        the classifier), `classifier`, or `openai_moderation`.\n        prompt_injection accepts only `classifier` (and `auto`, which\n        resolves to it): Moderation does not detect injection.\n    threshold: Probability or score at or above which the check fires.\n    action: `block` or `flag`; None inherits the file-wide `on_fail`.\n    direction: Which side the check reads; default both.\n    categories: harmful_content only: Moderation category names to\n        honor; empty means every category the endpoint reports.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "backend": {
          "default": "auto",
          "title": "Backend"
        },
        "threshold": {
          "default": 0.8,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        },
        "action": {
          "default": null,
          "title": "Action"
        },
        "direction": {
          "default": "input_output",
          "title": "Direction"
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        }
      },
      "title": "GuardrailModelCheckSettingsModel",
      "type": "object"
    },
    "GuardrailsSettingsModel": {
      "additionalProperties": false,
      "description": "The `guardrails` middleware: checks on requests and answers.\n\nAttributes:\n    on_fail: What a firing check does unless it says otherwise: `block`\n        raises AiGuardrailBlockedError; `flag` lets the call through and\n        names the check on the result and in the record.\n    on_error: What happens when a check itself fails (a backend outage):\n        `block` refuses the call, `allow` lets it through with a warning.\n    prompt_injection, harmful_content: The built-in model-backed checks.\n    custom: Policies of your own.\n    classifier: Which classifier the model-backed checks use.",
      "properties": {
        "on_fail": {
          "default": "block",
          "title": "On Fail"
        },
        "on_error": {
          "default": "block",
          "title": "On Error"
        },
        "prompt_injection": {
          "$ref": "#/$defs/GuardrailModelCheckSettingsModel"
        },
        "harmful_content": {
          "$ref": "#/$defs/GuardrailModelCheckSettingsModel"
        },
        "custom": {
          "items": {
            "$ref": "#/$defs/GuardrailCustomCheckSettingsModel"
          },
          "title": "Custom",
          "type": "array"
        },
        "classifier": {
          "$ref": "#/$defs/GuardrailClassifierSettingsModel"
        }
      },
      "title": "GuardrailsSettingsModel",
      "type": "object"
    }
  }
}
