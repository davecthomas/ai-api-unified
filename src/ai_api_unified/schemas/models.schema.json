        }
      },
      "title": "AIAwsProviderSettings",
      "type": "object"
    },
    "AIAzureSpeechProviderSettings": {
      "additionalProperties": false,
      "description": "`providers.azure_speech`: the Azure voice engine.",
      "properties": {
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        }
      },
      "title": "AIAzureSpeechProviderSettings",
      "type": "object"
    },
    "AIClassifierSelection": {
      "description": "The `classifier` section; also the router's classifier.",
      "properties": {
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "min_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Confidence"
        },
        "thinking": {
          "anyOf": [
            {
              "$ref": "#/$defs/AIThinkingLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        }
      },
      "title": "AIClassifierSelection",
      "type": "object"
    },
    "AICompletionsSelection": {
      "description": "The `completions` section.",
      "properties": {
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "fallbacks": {
          "items": {
            "type": "string",
            "description": "An 'engine:model' pair; the split is on the first colon."
          },
          "title": "Fallbacks",
          "type": "array"
        },
        "fallback_on": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AiFallbackReason"
              }
            },
            {
              "type": "string",
              "description": "Comma-separated AiFallbackReason values."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback On"
        },
        "retry_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Policy"
        },
        "thinking": {
          "anyOf": [
            {
              "$ref": "#/$defs/AIThinkingLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        },
        "cooldown": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AIFallbackCooldownPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cooldown"
        },
        "require": {
          "anyOf": [
            {
              "$ref": "#/$defs/AIConfigRequirements"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "AICompletionsSelection",
      "type": "object"
    },
    "AIConfigRequirements": {
      "description": "What every completions route must offer, checked at build.\n\nAttributes:\n    capabilities: Capability names each route's primary must support,\n        without the `supports_` prefix (structured_output, tool_use,\n        streaming, async, batch, token_counting, ...).\n    second_provider: True requires each route to hold a model on a\n        provider other than its primary's.\n    mode: \"warn\" logs an unmet requirement; \"strict\" raises.",
      "properties": {
        "capabilities": {
          "items": {
            "type": "string",
            "enum": [
              "async",
              "batch",
              "data_residency_constraint",
              "prompt_cache_hint",
              "streaming",
              "structured_output",
              "token_counting",
              "tool_use"
            ]
          },
          "title": "Capabilities",
          "type": "array"
        },
        "second_provider": {
          "default": false,
          "title": "Second Provider",
          "type": "boolean"
        },
        "mode": {
          "default": "warn",
          "enum": [
            "warn",
            "strict"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "AIConfigRequirements",
      "type": "object"
    },
    "AIEmbeddingsSelection": {
      "description": "The `embeddings` section.",
      "properties": {
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "dimensions": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimensions"
        }
      },
      "title": "AIEmbeddingsSelection",
      "type": "object"
    },
    "AIFallbackCandidate": {
      "description": "One (engine, model) pair in a fallback chain.\n\nAttributes:\n    engine: Completions engine token, as the factory accepts it.\n    model: Model name for that engine; blank means the engine default.\n    base_url: Optional API base-URL override for engines that accept one.",
      "properties": {
        "engine": {
          "title": "Engine",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        }
      },
      "required": [
        "engine"
      ],
      "title": "AIFallbackCandidate",
      "type": "object"
    },
    "AIFallbackCooldownPolicy": {
      "description": "How long a failed candidate rests.\n\nAttributes:\n    enabled: False turns cooldowns off; every call starts at the primary.\n    seconds: Rest per reason value (for example {\"rate_limited\": 10}),\n        merged over DICT_DEFAULT_COOLDOWN_SECONDS. 0 means no rest.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "seconds": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/AiFallbackReason"
          },
          "title": "Seconds",
          "type": "object"
        }
      },
      "title": "AIFallbackCooldownPolicy",
      "type": "object"
    },
    "AIGoogleProviderSettings": {
      "additionalProperties": false,
      "description": "`providers.google`: Gemini, Google images, video, and voice.",
      "properties": {
        "auth_method": {
          "anyOf": [
            {
              "enum": [
                "api_key",
                "service_account"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auth Method"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        }
      },
      "title": "AIGoogleProviderSettings",
      "type": "object"
    },
    "AIImagesSelection": {
      "description": "The `images` section.",
      "properties": {
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "title": "AIImagesSelection",
      "type": "object"
    },
    "AIModelCheckSelection": {
      "description": "The `model_check` section.",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "enum": [
                "prune",
                "strict",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        }
      },
      "title": "AIModelCheckSelection",
      "type": "object"
    },
    "AIOpenAICompatibleProviderSettings": {
      "additionalProperties": false,
      "description": "`providers.openai_compatible`: a self-hosted or third-party server.",
      "properties": {
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "structured_output": {
          "anyOf": [
            {
              "enum": [
                "json_schema",
                "json_object"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structured Output"
        },
        "context_window": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Window"
        },
        "thinking_control": {
          "anyOf": [
            {
              "enum": [
                "none",
                "reasoning_effort",
                "enable_thinking"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Control"
        }
      },
      "title": "AIOpenAICompatibleProviderSettings",
      "type": "object"
    },
    "AIOpenAIProviderSettings": {
      "additionalProperties": false,
      "description": "`providers.openai`: the OpenAI engines (chat, Responses, Decisions).",
      "properties": {
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        }
      },
      "title": "AIOpenAIProviderSettings",
      "type": "object"
    },
    "AIProvidersSelection": {
      "additionalProperties": false,
      "description": "The `providers` section: per-provider settings that are not secrets.\nAPI keys and other credentials stay in the environment.",
      "properties": {
        "openai": {
          "$ref": "#/$defs/AIOpenAIProviderSettings"
        },
        "anthropic": {
          "$ref": "#/$defs/AIAnthropicProviderSettings"
        },
        "google": {
          "$ref": "#/$defs/AIGoogleProviderSettings"
        },
        "aws": {
          "$ref": "#/$defs/AIAwsProviderSettings"
        },
        "openai_compatible": {
          "$ref": "#/$defs/AIOpenAICompatibleProviderSettings"
        },
        "azure_speech": {
          "$ref": "#/$defs/AIAzureSpeechProviderSettings"
        }
      },
      "title": "AIProvidersSelection",
      "type": "object"
    },
    "AIRouterClassifierConfig": {
      "description": "Which classifier the router uses.\n\nAttributes:\n    engine: Classification engine token, or \"none\" to route without a\n        classifier. None means the factory's own resolution\n        (CLASSIFIER_ENGINE, then openai-decisions when OPENAI_API_KEY is set).\n    model: Classification model; None means the engine's default.\n    base_url: Optional API base-URL override.\n    timeout_seconds: Per-call classifier timeout.\n    instructions: Prose prepended to the built-in routing instructions.\n    min_confidence: When the classifier reports a confidence below this\n        (0 to 1), the request goes one tier above the classifier's pick.\n        None turns the check off; a classifier that reports no\n        confidence keeps its pick.",
      "properties": {
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "timeout_seconds": {
          "default": 5.0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instructions"
        },
        "min_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Confidence"
        }
      },
      "title": "AIRouterClassifierConfig",
      "type": "object"
    },
    "AIRouterConfig": {
      "description": "The router's tiers and policy.\n\nAttributes:\n    tiers: Ascending capability; at least one.\n    classifier: Classifier selection; None means the factory's resolution.\n    default_tier: Tier used when classification is unavailable; None\n        means the default chain (the configured completions LLM).\n    on_exhausted: When a tier's chain is exhausted on a trigger reason,\n        \"escalate\" tries the next tier up; \"any\" tries every tier above\n        the pick, then the tiers below it, nearest first; \"raise\"\n        re-raises.\n    followup: How a follow-up turn of a plain conversation (one with an\n        earlier assistant turn and no tool calls) is routed.\n        \"reclassify\" classifies each turn on its own; \"ratchet\" never\n        routes it below the tier that served this client's previous\n        call. One client per conversation makes the ratchet exact; a\n        client shared across conversations should pass the floor per\n        call as provider_options[\"route_floor\"] instead.\n    fallback_on: Default trigger reasons for every tier's chain; None\n        means the factory's resolution (COMPLETIONS_FALLBACK_ON, then the\n        library default).",
      "properties": {
        "tiers": {
          "items": {
            "$ref": "#/$defs/AIRouterTier"
          },
          "minItems": 1,
          "title": "Tiers",
          "type": "array"
        },
        "classifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/AIRouterClassifierConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "default_tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Tier"
        },
        "on_exhausted": {
          "default": "escalate",
          "enum": [
            "escalate",
            "any",
            "raise"
          ],
          "title": "On Exhausted",
          "type": "string"
        },
        "followup": {
          "default": "reclassify",
          "enum": [
            "reclassify",
            "ratchet"
          ],
          "title": "Followup",
          "type": "string"
        },
        "fallback_on": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AiFallbackReason"
              }
            },
            {
              "type": "string",
              "description": "Comma-separated AiFallbackReason values."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback On"
        },
        "pruned_tiers": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Pruned Tiers",
          "type": "object"
        }
      },
      "required": [
        "tiers"
      ],
      "title": "AIRouterConfig",
      "type": "object"
    },
    "AIRouterTier": {
      "description": "One complexity tier.\n\nAttributes:\n    name: Lowercase token, unique in the config; the classifier returns it.\n    description: Prose the classifier reads to recognize the tier. Built\n        in for easy, medium, and hard; required otherwise.\n    candidates: The tier's models in order: the primary, then its chain.\n    fallback_on: Reasons that move a request along the tier's chain;\n        None means the router-level default.\n    thinking: The tier's thinking level (off, minimal, low, medium,\n        high, max); None means the router's level. A per-call level\n        still wins.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/AIFallbackCandidate"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "fallback_on": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AiFallbackReason"
              }
            },
            {
              "type": "string",
              "description": "Comma-separated AiFallbackReason values."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback On"
        },
        "thinking": {
          "anyOf": [
            {
              "$ref": "#/$defs/AIThinkingLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "models": {
          "description": "The tier's models in order, the primary first: 'engine:model' strings (comma-separated pairs allowed) or {engine, model, base_url} objects. Same as candidates.",
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/AIFallbackCandidate"
              }
            ]
          }
        }
      },
      "required": [
        "name"
      ],
      "title": "AIRouterTier",
      "type": "object",
      "oneOf": [
        {
          "required": [
            "models"
          ]
        },
        {
          "required": [
            "candidates"
          ]
        }
      ]
    },
    "AIThinkingLevel": {
      "description": "How much a model should think before answering, provider-neutral.\n\nMembers, in order:\n    OFF: No thinking. Models whose thinking is always on apply their\n        lowest level instead and record it.\n    MINIMAL: The least thinking a model offers above off.\n    LOW: Light reasoning; quick answers.\n    MEDIUM: The default. Balanced depth, mapped to each provider's own\n        medium (Anthropic `effort: medium`, OpenAI `reasoning_effort:\n        medium`, Gemini `thinking_level: medium`).\n    HIGH: Deep reasoning.\n    MAX: The most a model offers.",
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "max"
      ],
      "title": "AIThinkingLevel",
      "type": "string"
    },
    "AIVideosSelection": {
      "description": "The `videos` section.",
      "properties": {
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "output_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Dir"
        },
        "poll_interval_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
