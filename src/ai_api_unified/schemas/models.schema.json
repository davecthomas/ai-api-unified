{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davecthomas/ai-api-unified/main/src/ai_api_unified/schemas/models.schema.json",
  "$defs": {
    "AIAnthropicProviderSettings": {
      "additionalProperties": false,
      "description": "`providers.anthropic`: the `claude` engine.",
      "properties": {
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "admin_base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Admin Base Url"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        }
      },
      "title": "AIAnthropicProviderSettings",
      "type": "object"
    },
    "AIAwsProviderSettings": {
      "additionalProperties": false,
      "description": "`providers.aws`: Bedrock. Credentials stay in the AWS credential chain.",
